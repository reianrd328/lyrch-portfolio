uploads/profile/*
!uploads/profile/.gitkeep
uploads/projects/*
!uploads/projects/.gitkeep
uploads/videos/*
!uploads/videos/.gitkeep
uploads/gallery/*
!uploads/gallery/.gitkeep
uploads/documents/*
!uploads/documents/.gitkeep

