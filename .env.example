FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=lyrch-command-center-secret-key-change-in-production

# Local MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lyrch_portfolio

# Local MySQL direct URL
# DATABASE_URL=mysql+pymysql://root:1234@localhost:3306/lyrch_portfolio?charset=utf8mb4

# Live Production TiDB Cloud Serverless Connection URL:
# DATABASE_URL=mysql+pymysql://<user>.root:<password>@<host>.prod.aws.tidbcloud.com:4000/<dbname>?charset=utf8mb4
# TIDB_SSL=true

# Upload settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=52428800

